# Database
POSTGRES_USER=megarepomind
POSTGRES_PASSWORD=megarepomind_secret
POSTGRES_DB=megarepomind
DATABASE_URL=postgresql+asyncpg://megarepomind:megarepomind_secret@postgres:5432/megarepomind

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic (Claude API) - get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub (optional - avoids rate limits on public repos)
GITHUB_TOKEN=ghp_your_token_here

# App
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
ENVIRONMENT=development
